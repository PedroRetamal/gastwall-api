# Variables para tu base de datos local
DATABASE_URL=postgresql+psycopg://postgres:TU_CONTRASEÑA@localhost:5432/gastwall_db
SECRET_KEY=GENERA_UNA_CLAVE_SECRETA
ALGORITHM=HS256
EXPIRACION_MINUTOS=30

# Variables para Docker Compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ELIGE_UNA_CONTRASEÑA
POSTGRES_DB=gastwall_db
DATABASE_URL_DOCKER=postgresql+psycopg://postgres:ELIGE_UNA_CONTRASEÑA@db:5432/gastwall_db